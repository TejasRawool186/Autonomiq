# Autonomiq Configuration Environment Variables

# Application
APP_NAME=Autonomiq
APP_ENV=development
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]

# Database & Storage
DATABASE_URL=sqlite+aiosqlite:///./data/sqlite/autonomiq.db
QDRANT_PATH=./data/qdrant
DATA_DIR=./data
UPLOAD_DIR=./data/uploads
ARTIFACT_DIR=./data/artifacts

# Local AI Runtime (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:1b
# Supported & auto-detected models: gemma3:1b, qwen2.5:1.5b, qwen3:1.7b, qwen3:4b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Web Research (SerpApi)
SERPAPI_API_KEY=

# Durable Workflows (Temporal) - Optional for direct execution mode

TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=autonomiq-tasks

# Observability & Tracing (Sentry) - Optional
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# Voice Digest (ElevenLabs) - Optional
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Optional Memory (MongoDB Atlas)
MONGODB_URI=
